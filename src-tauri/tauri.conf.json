{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hangho POS",
  "version": "1.0.0",
  "identifier": "com.hangho.pos",
  "build": {
    "frontendDist": "../public/legacy",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Hangho — Quản lý bán hàng offline",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
